DATABASE_URL=postgresql+psycopg://tableflow:tableflow-dev-password@db:5432/tableflow
JWT_SECRET=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000

# Set to LAN/hosted URL reachable by customer phones (not localhost for phones).
PUBLIC_CUSTOMER_URL=http://localhost:3000
# Optional hosted card checkout: real charges require a Stripe account.
# Delivery also offers a demo-only card flow validated with Luhn; it never charges or stores card details.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
